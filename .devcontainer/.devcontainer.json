{
  "name": "EF101-P07 Campus Booking (Streamlit)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Booking System", "onAutoForward": "openPreview" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
